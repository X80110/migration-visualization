library(tidyverse)
library(countrycode)
library(migest)
library(jsonlite)
f <- read_csv("../refilterbynumberoflinks/data/bilat_mig.csv")
##
## data1: json for flows
## data2: json for flows by sex
## data3: json for flows by type
## data4: json for stocks
## data5: json for stocks by sex
##
library(tidyverse)
library(countrycode)
library(migest)
library(jsonlite)
f <- read_csv("./data/bilat_mig.csv")
# f <- read_csv("..\\global-bilat-flow-sex\\est-v04\\bilat_mig.csv")
# f <- read_csv("https://ndownloader.figshare.com/files/26239945")
d0 <- f %>%
mutate(
orig_area = countrycode(
sourcevar = orig, custom_dict = dict_ims,
origin = "iso3c", destination = "region_ac2022"),
dest_area = countrycode(
sourcevar = dest, custom_dict = dict_ims,
origin = "iso3c", destination = "region_ac2022")) %>%
pivot_longer(cols = 4:9, names_to = "method", values_to = "flow")
d1 <- d0 %>%
group_by(method, year0) %>%
sum_expand(guess_order = TRUE, return_matrix = FALSE)
# expand data frame to get consistent dimensions over all periods
d2 <- d1 %>%
ungroup() %>%
complete(orig, dest, year0, method, fill = list(flow = 0))
# order of regions and countries, following latest plots
n0 <- unique(dict_ims$region_ac2022) %>%
.[c(1, 2, 8, 3, 7, 6, 4, 5, 11, 9, 10)]
n1 <- tibble(lab0 = unique(d1$orig)) %>%
mutate(area = ifelse(str_length(lab0) > 3, lab0, NA),
lab1 = countrycode(sourcevar = lab0, custom_dict = dict_ims,
origin = "iso3c", destination = "name_short"),
lab1 = stringi::stri_trans_general(str = lab1, id = "latin-ascii")) %>%
fill(area) %>%
mutate(area = factor(area, levels = n0)) %>%
arrange(area, lab1) %>%
mutate(lab1 = ifelse(is.na(lab1), as.character(area), lab1)) %>%
group_by(area) %>%
nest() %>%
mutate(d = map(.x = data, .f = ~slice(.x, n(), 1:(n()-1)))) %>%
select(-data) %>%
unnest(d) %>%
ungroup() %>%
mutate(flag = countrycode(sourcevar = lab0, origin = "iso3c", destination = "unicode.symbol"))
# totals
d3a <- d1 %>%
filter(orig %in% n0,
dest %in% n0) %>%
group_by(year0, method) %>%
sum_country() %>%
select(-turn, -net) %>%
ungroup()
d3b <- d1 %>%
filter(!orig %in% n0,
!dest %in% n0) %>%
group_by(year0, method) %>%
sum_country() %>%
select(-turn, -net) %>%
ungroup() %>%
mutate(
country = countrycode(sourcevar = country, custom_dict = dict_ims,
origin = "iso3c", destination = "name_short"),
country = stringi::stri_trans_general(str = country, id = "latin-ascii")
)
d3 <- d3a %>%
bind_rows(d3b) %>%
mutate(country = factor(country, levels = n1$lab1)) %>%
arrange(country)
# matrices
m <- d2 %>%
mutate(orig = factor(orig, levels = n1$lab0),
dest = factor(dest, levels = n1$lab0)) %>%
arrange(method, year0, orig, dest) %>%
xtabs(formula = round(flow) ~ orig + dest + method + year0, data = .,) %>%
array_tree(margin = c(3, 4))
# threshold
thresholds <- d0 %>%
group_by(method) %>%
summarise(threshold = 10000)
# colours
p <- colorRampPalette(migest::umbrella)(length(which(n1$area == n1$lab1)))
# Create flows directory if it doesn't exist
if (!dir.exists("flows")) {
dir.create("flows")
}
# Process each method
methods <- names(m)
for (method in methods) {
# Create method subdirectory
method_dir <- file.path("flows", method)
if (!dir.exists(method_dir)) {
dir.create(method_dir)
}
# --- NEW CALCULATION START ---
# Calculate the max turnover (Inflow + Outflow) for each node across all years
max_total_flow <- d3 %>%
filter(method == !!method) %>%
# Calculate the sum of flows for the node
mutate(total_flow = imm + emi) %>%
rename(year = year0) %>%
# Use 'country' as the node identifier
select(year, country, total_flow) %>%
# Create the matrix (rows=years, cols=countries)
xtabs(formula = round(total_flow) ~ year + country, data = .,) %>%
as.matrix() %>%
# Find the maximum value in each column (node)
apply(2, max) %>%
unname()
# --- NEW CALCULATION END ---
# Process each year for this method
year_data <- m[[method]]
years <- names(year_data)
# --- UPDATED META LIST ---
meta <- list(
threshold = thresholds %>% filter(method == !!method) %>% pull(threshold),
years = years,
# Export the new combined metric instead of the separated ones
max_total_flow = max_total_flow
)
# Save meta.json
write_json(meta, file.path(method_dir, "dataset_meta.json"), auto_unbox = TRUE, pretty = TRUE)
for (year in years) {
# Create JSON with just the matrix
matrix_data <- list(matrix = year_data[[year]])
# Save as year.json
write_json(matrix_data, file.path(method_dir, paste0(year, ".json")),
auto_unbox = TRUE, pretty = TRUE)
}
}
